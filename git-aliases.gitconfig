[core]
	editor = code --wait
[user]
	email = bakdatbakdatov@gmail.com
	name = Bakdat
[alias]
	s = status --short
	l = log --oneline --graph --decorate --all
	g = log --color=always --graph --abbrev-commit --decorate --all --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%ad%C(dim white) - %an%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n %C(white)%s%C(reset)'
	br = branch
	co = checkout
